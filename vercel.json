{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/:id(\\d+)",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/apps",
      "destination": "/our-apps",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(screens|icons|og)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
